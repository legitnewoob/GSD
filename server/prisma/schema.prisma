generator client {

  provider = "prisma-client-js"

}
datasource db {
  provider = "postgresql"
}
model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  habits        Habit[]
  categories    Category[]
  entries       Entry[]
  budgetSetting BudgetSetting?
  expenses      Expense[]
  todos         Todo[]
  googleFitToken GoogleFitToken?
  notificationRules NotificationRule[]
  pushSubscriptions PushSubscription[]
  learningTopics LearningTopic[]
  codingProfiles CodingProfile[]

  @@map("users")
}

model Habit {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  name     String
  icon     String?
  order    Int     @default(0)
  xpValue  Int     @default(5) @map("xp_value")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryHabits EntryHabit[]

  @@map("habits")
}

model Category {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  key           String? // stable slug like 'sleep', 'exercise', 'deep_work'
  name          String
  color         String?
  expectedHours Float?  @map("expected_hours")
  order         Int     @default(0)
  isActive      Boolean @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryCategories EntryCategory[]

  @@map("categories")
}

model Entry {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  date          String // YYYY-MM-DD
  day           String?
  moodLabel     String? @map("mood_label")
  energyLabel   String? @map("energy_label")
  powerLabel    String? @map("power_label")
  moodScore     Int?    @map("mood_score")
  energyScore   Int?    @map("energy_score")
  powerScore    Int?    @map("power_score")
  screenTime    Float?  @map("screen_time")
  money         Float?
  runWalk       Float?  @map("run_walk")
  steps         Int?
  bigWin        String? @map("big_win")
  drain         String?
  tomorrow      String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits      EntryHabit[]
  categories  EntryCategory[]
  expenses    Expense[]

  @@unique([userId, date])
  @@map("entries")
}

model EntryHabit {
  id        String  @id @default(cuid())
  entryId   String  @map("entry_id")
  habitId   String  @map("habit_id")
  completed Boolean @default(false)

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([entryId, habitId])
  @@map("entry_habits")
}

model EntryCategory {
  id         String  @id @default(cuid())
  entryId    String  @map("entry_id")
  categoryId String  @map("category_id")
  hours      Float?

  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([entryId, categoryId])
  @@map("entry_categories")
}

model BudgetSetting {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  monthlyIncome   Float?   @map("monthly_income")
  cashBalance     Float?   @map("cash_balance")
  bankBalance       Float?   @map("bank_balance")
  salaryDay         Int?     @map("salary_day")
  lastSalaryCredit  String?  @map("last_salary_credit")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategories BudgetCategory[]
  creditCards      CreditCard[]

  @@map("budget_settings")
}

model BudgetCategory {
  id              String   @id @default(cuid())
  budgetSettingId String   @map("budget_setting_id")
  name            String
  type            String   @default("daily")
  budgetedAmount  Float    @default(0) @map("budgeted_amount")
  spentAmount     Float    @default(0) @map("spent_amount")
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  budgetSetting BudgetSetting @relation(fields: [budgetSettingId], references: [id], onDelete: Cascade)

  @@map("budget_categories")
}

model CreditCard {
  id              String   @id @default(cuid())
  budgetSettingId String   @map("budget_setting_id")
  name            String
  currentBalance  Float    @default(0) @map("current_balance")
  creditLimit     Float?   @map("credit_limit")
  rewardPoints    Float?   @map("reward_points")
  isPaid          Boolean  @default(false) @map("is_paid")
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  budgetSetting BudgetSetting @relation(fields: [budgetSettingId], references: [id], onDelete: Cascade)

  @@map("credit_cards")
}

model Expense {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  entryId     String? @map("entry_id")
  amount      Float
  description String?
  date        String
  createdAt   DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry Entry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Todo {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  text        String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

model NotificationRule {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  message      String
  time         String   // "HH:MM", 24h, in REMINDER_TIMEZONE
  daysOfWeek   String   @default("0,1,2,3,4,5,6") @map("days_of_week") // comma-separated 0=Sun..6=Sat
  isActive     Boolean  @default(true) @map("is_active")
  lastSentDate String?  @map("last_sent_date") // "YYYY-MM-DD" in REMINDER_TIMEZONE, dedupes sends
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_rules")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model LearningTopic {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  category  String   // 'cp' | 'dev' | 'system_design' | 'ai_engineering'
  name      String
  status    String   @default("todo") // 'todo' | 'in_progress' | 'done'
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_topics")
}

model CodingProfile {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  platform  String   // 'codeforces' | 'leetcode' | 'atcoder'
  username  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("coding_profiles")
}

model GoogleFitToken {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_fit_tokens")
}
