# Supabase Postgres connection string
# Get this from your Supabase project: Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# Server port
PORT=4000

# Default user id used by the single-user web app
DEFAULT_USER_ID="00000000-0000-0000-0000-000000000001"

# Frontend domain for CORS (set to your deployed frontend URL)
# In dev, leave empty or use http://localhost:5173
FRONTEND_URL=http://localhost:5173
